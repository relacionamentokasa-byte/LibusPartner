# Configuração do Servidor
PORT=3333
NODE_ENV=production

# URL do Banco de Dados PostgreSQL (Ex: Supabase ou Neon)
DATABASE_URL="postgresql://usuario:senha@host:5432/libus_partner?sslmode=require"

# Chave Secreta para JWT
JWT_SECRET="libus-partner-jwt-super-secret-key-production"

# Configuração de E-mail SMTP (Ex: Resend ou Brevo)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_seu_token_aqui"
SMTP_FROM="Libus Partner <nao-responda@seudominio.com.br>"

# URL do Frontend em Produção (Vercel)
FRONTEND_URL="https://libus-partner.vercel.app"
